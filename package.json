{
  "name": "foundry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rls": "bash scripts/test-rls.sh",
    "lint": "eslint .",
    "format": "prettier --write src scripts e2e eslint.config.js vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src scripts e2e eslint.config.js vite.config.ts playwright.config.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@zxing/browser": "^0.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "license": "UNLICENSED"
}
